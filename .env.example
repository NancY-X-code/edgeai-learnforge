# EdgeAI LearnForge — Environment Variables
# Copy this file to .env and fill in your values.
# The application works fully offline without any API key (heuristic fallback mode).

# ── Google Gemini API (Optional) ───────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
# Leave as "placeholder_key" to use heuristic / Ollama mode.
GEMINI_API_KEY=placeholder_key

# ── Ollama Local LLM (Optional) ───────────────────────────────────────────────
# Install Ollama from https://ollama.ai and run: ollama pull llama3.2:1b
# Recommended for better quality notes and quiz generation without cloud costs.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
